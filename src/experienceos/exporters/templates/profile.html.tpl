  .entry { margin: 36px 0 44px; }
  .entry h2 { font-size: 1.125rem; margin: 0 0 2px; }
  .meta { margin: 0 0 10px; color: #737373; font-size: .875rem; }
  .context { color: #575757; }
  h3 { font-size: .9375rem; margin: 18px 0 6px; color: #444; }
  ul { margin: 0; padding-left: 22px; }
  li { margin: 4px 0; }
