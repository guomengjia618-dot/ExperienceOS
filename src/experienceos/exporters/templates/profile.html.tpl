    color: #575757; font-style: italic; }
  a { color: inherit; text-underline-offset: 3px; }
  .kind { display: inline-block; min-width: 4.2em; color: #737373;
    font-size: .75rem; text-transform: uppercase; letter-spacing: .4px; }
  .local { color: #575757; }
  @media print {
    body { padding: 0; font-size: 11pt; max-width: none; }
