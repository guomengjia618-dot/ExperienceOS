<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Experience profile — $count record(s)</title>
<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body {
    margin: 0 auto; padding: 40px 24px 64px; max-width: 820px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 15px; line-height: 1.7; color: #252525; background: #fff;
  }
  h1 { font-size: 1.5rem; letter-spacing: -.3px; margin: 0 0 4px; }
  .footer { margin-top: 48px; padding-top: 14px; border-top: 1px solid #e9e9e7;
